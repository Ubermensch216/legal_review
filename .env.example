# ============================================================
# Legal Reviewer Standalone - 환경 설정 템플릿 (.env.example)
# setup.bat 실행 시 .env 파일이 없으면 이 파일을 복사해 생성합니다.
# ============================================================

# 서버 바인딩 설정
PORT=3000
HOST=127.0.0.1

# 국가법령정보센터(open.law.go.kr) OpenAPI 인증키 (계정 ID)
# 미입력 시 공식 법령 조회가 제한됩니다. (LAW_DEMO_MODE=true 로 샘플 모드 테스트 가능)
LAW_OC=
DECISIONS_API_KEY=
HUNZAE_API_KEY=
LAW_DEMO_MODE=false

# 기본 LLM 설정 (로컬 Ollama 권장)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b
OLLAMA_EMBED_MODEL=bge-m3

# 로컬 모델(gemma4:e2b) 토큰 예산 및 타임아웃 최적화
LLM_MODEL_BUDGETS={"ollama:gemma4:e2b":{"contextTokens":40960,"outputTokens":8192,"tokensPerChar":{"hangul":0.75}}}
LLM_SECTION_BUDGETS={"precedents":12000,"interpretations":9000}
LLM_TIMEOUT=900000
SERVER_REQUEST_TIMEOUT=1200000

# 선택: 외부(클라우드) LLM API 키 (병용 또는 외부 전용 모드 사용 시 입력)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# LG EXAONE API (https://docs.exaone.ai/ko/docs/quick-start)
EXAONE_API_KEY=
EXAONE_MODEL=k-exaone_v2.5

# 분석 스킬(skills/<id>/) 적용 방식. 화면 설정이 있으면 화면 값이 우선한다.
#   auto  : 검수된 스킬만 적용, 검수 전 스킬은 문서 점검 결과를 진단으로만 남김 (기본)
#   apply : 검수 전 스킬도 적용 (의견서에 '전문가 검수 전'으로 표시)
#   off   : 분석 스킬 사용 안 함 (계약서 검토의 기존 규칙은 그대로)
REVIEW_SKILLS=auto
