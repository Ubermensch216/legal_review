# ==========================================
# Legal Reviewer - 환경 변수 설정 파일 (.env)
# ==========================================

# 서버 포트 & 호스트
PORT=3000
HOST=0.0.0.0

# 1. 국가법령정보센터 (law.go.kr) 오픈API 인증키
# 발급처: https://open.law.go.kr
LAW_OC=your_law_oc_id_here

# 2. 종합법률정보 / 판례 / 결정례 API 키 (선택사항)
DECISIONS_API_KEY=
HUNZAE_API_KEY=

# 3. LLM 설정
# LLM Provider: 'ollama' | 'openai' | 'anthropic' | 'gemini'
LLM_PROVIDER=ollama

# Ollama 로컬 LLM 설정
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b
# 모델을 메모리에 유지해 매 호출마다 재적재하지 않도록 함
OLLAMA_KEEP_ALIVE=30m
# 생성할 최대 토큰 수 (줄이면 빨라지지만 의견서가 짧아짐)
OLLAMA_NUM_PREDICT=4096

# LLM 타임아웃 (ms)
# LLM_PROBE_TIMEOUT: Ollama 미기동 여부만 판별하는 헬스체크 타임아웃 (짧게)
# LLM_TIMEOUT: 실제 생성 응답 대기 시간. 로컬 모델은 수 분이 걸릴 수 있으므로 넉넉히 설정
LLM_PROBE_TIMEOUT=2000
LLM_TIMEOUT=600000

# 장시간 검토 요청이 전송 계층에서 끊기지 않도록 하는 HTTP 서버 타임아웃 (ms)
SERVER_REQUEST_TIMEOUT=900000

# 클라우드 LLM API Keys (사용 시)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 4. 캐시 및 데이터 디렉토리
CACHE_DIR=./data/cache
UPLOAD_DIR=./data/uploads
