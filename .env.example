# ── 서버 ─────────────────────────────────────────────
PORT=3000
HOST=127.0.0.1

# ── 국가법령정보센터 Open API ────────────────────────
# open.law.go.kr 에서 발급받은 본인 계정 ID(OC)를 입력합니다.
# 미설정 시 공식 자료 조회 불가로 표시합니다.
# 샘플 UI 확인에만 LAW_DEMO_MODE=true를 사용하십시오. 샘플은 LLM 근거에서 제외됩니다.
LAW_OC=
LAW_DEMO_MODE=false

# ── LLM 엔진 ─────────────────────────────────────────
# ollama | openai | anthropic | gemini | rule_based
# rule_based는 법리 추론을 수행하지 않는 축소 폴백입니다.
LLM_PROVIDER=ollama

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
# 로컬 모델은 프롬프트 처리에 수 분이 걸릴 수 있습니다 (단위: ms)
LLM_TIMEOUT=600000
LLM_PROBE_TIMEOUT=2000
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=8192

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── 경로 ─────────────────────────────────────────────
CACHE_DIR=
UPLOAD_DIR=
