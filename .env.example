# ==========================================
# Legal Reviewer - 환경 변수 설정 파일 (.env)
# ==========================================

# 서버 포트 & 호스트
PORT=3000
HOST=0.0.0.0

# 1. 국가법령정보센터 (law.go.kr) 오픈API 인증키
# 발급처: https://open.law.go.kr
LAW_OC=your_law_oc_id_here

# 2. 종합법률정보 / 판례 / 결정례 API 키 (선택사항)
DECISIONS_API_KEY=
HUNZAE_API_KEY=

# 3. LLM 설정
# LLM Provider: 'ollama' | 'openai' | 'anthropic' | 'gemini'
LLM_PROVIDER=ollama

# Ollama 로컬 LLM 설정
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# 클라우드 LLM API Keys (사용 시)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 4. 캐시 및 데이터 디렉토리
CACHE_DIR=./data/cache
UPLOAD_DIR=./data/uploads
